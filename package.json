{
  "name": "syrup",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:lib && vite",
    "build": "npm run build:lib && vite build",
    "preview": "vite preview",
    "build:lib": "npm run build --workspace @wytamma/maple-wasm",
    "build:wasm": "pixi run build-wasm",
    "check": "npm run build:lib && svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "node --experimental-strip-types --test src/lib/phylocanvas/*.test.ts src/lib/*.test.ts",
    "test:lib": "npm run test --workspace @wytamma/maple-wasm",
    "smoke:lib": "npm run smoke --workspace @wytamma/maple-wasm"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.12.3",
    "@types/three": "^0.184.1",
    "playwright": "^1.60.0",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@phylocanvas/phylocanvas.gl": "^1.62.0",
    "@tabee/browser": "^0.1.0",
    "@tabee/formats": "^0.1.0",
    "@tabee/protocol": "^0.1.0",
    "@wytamma/maple-wasm": "^0.1.0",
    "deck.gl": "8.3.10",
    "three": "^0.184.0"
  }
}